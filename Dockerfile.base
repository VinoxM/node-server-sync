FROM gitea.vinoxm.art/library/node:24.12-slim

# 安装 sqlite3 编译所需的依赖
# python3, make, g++ 是 node-gyp 必须的
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /models

# 设置工作目录
WORKDIR /app

# 先拷贝 package.json 和 lock 文件以利用缓存加速构建
COPY package*.json ./

# 安装依赖
RUN npm config set registry https://mirrors.cloud.tencent.com/npm/ && \
    export SHARP_DIST_BASE_URL="https://npmmirror.com/mirrors/sharp-libvips/" && \
    npm install

COPY install.js ./

RUN node install.js